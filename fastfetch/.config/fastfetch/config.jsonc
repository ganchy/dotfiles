{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "none"
    },

    "display": {
        "separator": " ",
        "key": {
            "width": 8
        }
    },

    "modules": [
    {
        "type": "os",
        "key": "os"
    },
    {
        "type": "kernel",
        "key": "kernel"
    },
    {
        "type": "wm",
        "key": "wm"
    },
    {
        "type": "shell",
        "key": "shell"
    },
    {
        "type": "terminal",
        "key": "term"
    },
    {
        "type": "uptime",
        "key": "up"
    },
    {
        "type": "packages",
        "key": "pkgs"
    },
    {
        "type": "cpu",
        "key": "cpu",
        "format": "{name}"
    },
    {
        "type": "memory",
        "key": "mem"
    },
    {
        "type": "disk",
        "key": "disk",
        "folders": "/"
    },
    {
        "type": "battery",
        "key": "bat"
    },

    "break",

{
    "type": "colors",
    "key": "colors",
    "symbol": "block",
    "paddingLeft": 0,
    "block": {
        "width": 2,
        "range": [0, 7]
    }
},
{
    "type": "colors",
    "key": " ",
    "symbol": "block",
    "paddingLeft": 7,
    "block": {
        "width": 2,
        "range": [8, 15]
    }
}
]
}

