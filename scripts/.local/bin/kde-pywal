#!/usr/bin/env bash

set -euo pipefail

WAL_JSON="$HOME/.cache/wal/colors.json"
BASE="/usr/share/color-schemes/BreezeDark.colors"
SCHEME_DIR="$HOME/.local/share/color-schemes"

SCHEME_A="$SCHEME_DIR/PywalA.colors"
SCHEME_B="$SCHEME_DIR/PywalB.colors"

if [ ! -f "$WAL_JSON" ]; then
    echo "Could not find $WAL_JSON"
    exit 1
fi

if [ ! -f "$BASE" ]; then
    echo "Could not find $BASE"
    exit 1
fi

mkdir -p "$SCHEME_DIR"

hex_to_rgb() {
    local hex="${1#\#}"

    printf '%d,%d,%d' \
        "0x${hex:0:2}" \
        "0x${hex:2:2}" \
        "0x${hex:4:2}"
}

mix_rgb() {
    local a="${1#\#}"
    local b="${2#\#}"
    local percent="$3"

    local ar=$((16#${a:0:2}))
    local ag=$((16#${a:2:2}))
    local ab=$((16#${a:4:2}))

    local br=$((16#${b:0:2}))
    local bg=$((16#${b:2:2}))
    local bb=$((16#${b:4:2}))

    local r=$(((ar * (100 - percent) + br * percent) / 100))
    local g=$(((ag * (100 - percent) + bg * percent) / 100))
    local bl=$(((ab * (100 - percent) + bb * percent) / 100))

    printf '%d,%d,%d' "$r" "$g" "$bl"
}

#
# Pywal special colors.
#
BG_HEX=$(jq -r '.special.background' "$WAL_JSON")
FG_HEX=$(jq -r '.special.foreground' "$WAL_JSON")

#
# Full pywal16 palette.
#
C0_HEX=$(jq -r '.colors.color0' "$WAL_JSON")
C1_HEX=$(jq -r '.colors.color1' "$WAL_JSON")
C2_HEX=$(jq -r '.colors.color2' "$WAL_JSON")
C3_HEX=$(jq -r '.colors.color3' "$WAL_JSON")
C4_HEX=$(jq -r '.colors.color4' "$WAL_JSON")
C5_HEX=$(jq -r '.colors.color5' "$WAL_JSON")
C6_HEX=$(jq -r '.colors.color6' "$WAL_JSON")
C7_HEX=$(jq -r '.colors.color7' "$WAL_JSON")

C8_HEX=$(jq -r '.colors.color8' "$WAL_JSON")
C9_HEX=$(jq -r '.colors.color9' "$WAL_JSON")
C10_HEX=$(jq -r '.colors.color10' "$WAL_JSON")
C11_HEX=$(jq -r '.colors.color11' "$WAL_JSON")
C12_HEX=$(jq -r '.colors.color12' "$WAL_JSON")
C13_HEX=$(jq -r '.colors.color13' "$WAL_JSON")
C14_HEX=$(jq -r '.colors.color14' "$WAL_JSON")
C15_HEX=$(jq -r '.colors.color15' "$WAL_JSON")

BG=$(hex_to_rgb "$BG_HEX")
FG=$(hex_to_rgb "$FG_HEX")

C0=$(hex_to_rgb "$C0_HEX")
C1=$(hex_to_rgb "$C1_HEX")
C2=$(hex_to_rgb "$C2_HEX")
C3=$(hex_to_rgb "$C3_HEX")
C4=$(hex_to_rgb "$C4_HEX")
C5=$(hex_to_rgb "$C5_HEX")
C6=$(hex_to_rgb "$C6_HEX")
C7=$(hex_to_rgb "$C7_HEX")

C8=$(hex_to_rgb "$C8_HEX")
C9=$(hex_to_rgb "$C9_HEX")
C10=$(hex_to_rgb "$C10_HEX")
C11=$(hex_to_rgb "$C11_HEX")
C12=$(hex_to_rgb "$C12_HEX")
C13=$(hex_to_rgb "$C13_HEX")
C14=$(hex_to_rgb "$C14_HEX")
C15=$(hex_to_rgb "$C15_HEX")

#
# Semantic KDE colors.
#
# Dark bank:
#   color1-7  = subdued/base variants
#
# Bright bank:
#   color9    = negative/error
#   color10   = positive
#   color11   = neutral/warning
#   color12   = primary accent
#   color13   = visited/secondary accent
#   color14   = alternate highlight
#   color15   = bright foreground
#
ACCENT="$C12"
VISITED="$C13"
NEGATIVE="$C9"
POSITIVE="$C10"
NEUTRAL="$C11"
SELECTION="$C12"

#
# Subtle UI-derived colors.
#
ALT=$(mix_rgb "$BG_HEX" "$FG_HEX" 8)
MUTED=$(mix_rgb "$BG_HEX" "$FG_HEX" 55)

echo "Pywal16 KDE palette"
echo "-------------------"
echo "Background: $BG_HEX"
echo "Foreground: $FG_HEX"
echo "Accent:     $C12_HEX (color12)"
echo "Visited:    $C13_HEX (color13)"
echo "Negative:   $C9_HEX  (color9)"
echo "Positive:   $C10_HEX (color10)"
echo "Neutral:    $C11_HEX (color11)"
echo "Selection:  $C12_HEX (color12)"

CURRENT_SCHEME=$(
    kreadconfig6 \
        --file kdeglobals \
        --group General \
        --key ColorScheme
)

#
# Alternate A/B every run so KDE applications reload the scheme.
#
if [ "$CURRENT_SCHEME" = "PywalA" ]; then
    SCHEME="$SCHEME_B"
    SCHEME_ID="PywalB"
    SCHEME_NAME="Pywal B"
else
    SCHEME="$SCHEME_A"
    SCHEME_ID="PywalA"
    SCHEME_NAME="Pywal A"
fi

echo "Current KDE scheme: ${CURRENT_SCHEME:-none}"
echo "Applying: $SCHEME_ID"

cp -f "$BASE" "$SCHEME"
chmod 644 "$SCHEME"

kwriteconfig6 \
    --file "$SCHEME" \
    --group General \
    --key Name "$SCHEME_NAME"

#
# Replace Breeze colors.
#
sed -i -E \
    "s/^BackgroundNormal=.*/BackgroundNormal=$BG/;
     s/^BackgroundAlternate=.*/BackgroundAlternate=$ALT/;
     s/^ForegroundNormal=.*/ForegroundNormal=$FG/;
     s/^ForegroundInactive=.*/ForegroundInactive=$MUTED/;
     s/^ForegroundActive=.*/ForegroundActive=$ACCENT/;
     s/^ForegroundLink=.*/ForegroundLink=$ACCENT/;
     s/^ForegroundVisited=.*/ForegroundVisited=$VISITED/;
     s/^ForegroundNegative=.*/ForegroundNegative=$NEGATIVE/;
     s/^ForegroundNeutral=.*/ForegroundNeutral=$NEUTRAL/;
     s/^ForegroundPositive=.*/ForegroundPositive=$POSITIVE/;
     s/^DecorationHover=.*/DecorationHover=$ACCENT/;
     s/^DecorationFocus=.*/DecorationFocus=$ACCENT/" \
    "$SCHEME"

#
# KDE/Qt selection colors.
#
for KEY in BackgroundNormal BackgroundAlternate
do
    kwriteconfig6 \
        --file "$SCHEME" \
        --group "Colors:Selection" \
        --key "$KEY" "$SELECTION"
done

for KEY in ForegroundNormal ForegroundInactive ForegroundActive
do
    kwriteconfig6 \
        --file "$SCHEME" \
        --group "Colors:Selection" \
        --key "$KEY" "$BG"
done

#
# Window-manager/titlebar colors.
#
kwriteconfig6 \
    --file "$SCHEME" \
    --group WM \
    --key activeBackground "$BG"

kwriteconfig6 \
    --file "$SCHEME" \
    --group WM \
    --key activeForeground "$FG"

kwriteconfig6 \
    --file "$SCHEME" \
    --group WM \
    --key inactiveBackground "$ALT"

kwriteconfig6 \
    --file "$SCHEME" \
    --group WM \
    --key inactiveForeground "$MUTED"

#
# Force KDE to use the pywal16 accent.
#
kwriteconfig6 \
    --file kdeglobals \
    --group General \
    --key accentColorFromWallpaper false

kwriteconfig6 \
    --file kdeglobals \
    --group General \
    --key AccentColor "$ACCENT"

#
# Generate the KWrite/KTextEditor Pywal16 syntax theme.
#
if [ -x "$HOME/.local/bin/kwrite-pywal16" ]; then
    "$HOME/.local/bin/kwrite-pywal16"
fi

plasma-apply-colorscheme "$SCHEME_ID"

echo "Applied KDE scheme: $SCHEME_ID"
