#!/usr/bin/fish

set NNN_SOCKET "unix:@desktop-nnn"
set TERMINAL_SOCKET "unix:@desktop-terminal"
set RMPC_SOCKET "unix:@desktop-rmpc"
set KEYS_SOCKET "unix:@desktop-keys"

function show_widgets
    kitten @ --to="$NNN_SOCKET" resize-os-window --action=show >/dev/null 2>&1
    kitten @ --to="$TERMINAL_SOCKET" resize-os-window --action=show >/dev/null 2>&1
    kitten @ --to="$RMPC_SOCKET" resize-os-window --action=show >/dev/null 2>&1
    kitten @ --to="$KEYS_SOCKET" resize-os-window --action=show >/dev/null 2>&1
end

function hide_widgets
    kitten @ --to="$NNN_SOCKET" resize-os-window --action=hide >/dev/null 2>&1
    kitten @ --to="$TERMINAL_SOCKET" resize-os-window --action=hide >/dev/null 2>&1
    kitten @ --to="$RMPC_SOCKET" resize-os-window --action=hide >/dev/null 2>&1
    kitten @ --to="$KEYS_SOCKET" resize-os-window --action=hide >/dev/null 2>&1
end

function update_widgets
    set ACTIVE_WS (hyprctl activeworkspace -j | jq -r '.id')


    set WINDOW_COUNT (
    hyprctl clients -j | jq --argjson ws "$ACTIVE_WS" '
    [
        .[]
        | select(.workspace.id == $ws)
        | ((.class // "") | ascii_downcase) as $class
        | select(
            $class != "waypaper"
            and $class != "wofi"
            and $class != "wallpaper-picker"
        )
    ] | length'
)

    if test "$WINDOW_COUNT" -eq 0
        show_widgets
    else
        hide_widgets
    end
end

# Wait until all widget sockets are available.
while true
    set ready 1

    for socket in \
        "$NNN_SOCKET" \
        "$TERMINAL_SOCKET" \
        "$RMPC_SOCKET" \
        "$KEYS_SOCKET"

        if not kitten @ --to="$socket" ls >/dev/null 2>&1
            set ready 0
            break
        end
    end

    if test "$ready" -eq 1
        break
    end

    sleep 0.2
end

update_widgets

set SOCKET "$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

socat -U - "UNIX-CONNECT:$SOCKET" | while read event
    switch "$event"
        case 'openwindow*' 'closewindow*' 'movewindow*' 'workspace*' 'focusedmon*'
            sleep 0.02
            update_widgets
    end
end
