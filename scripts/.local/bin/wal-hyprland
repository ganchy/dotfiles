#!/bin/sh

WAL="$HOME/.local/bin/wal"

# Use the first argument if provided.
# Fall back to the default wallpaper.
WALLPAPER="${1:-$HOME/Pictures/Wallpapers/kurapika.jpg}"

# Stop if the file does not exist.
if [ ! -f "$WALLPAPER" ]; then
    echo "wal-hyprland: wallpaper not found: $WALLPAPER" >&2
    exit 1
fi

#
# Generate full pywal16 palette.
#
"$WAL" --cols16 lighten -n -i "$WALLPAPER"

# Tell already-running Fish shells to reload pywal syntax colors.
pkill -WINCH -x fish 2>/dev/null || true

#
# Update Vesktop from the new pywal16 palette.
#
if [ -x "$HOME/.local/bin/wal-vesktop" ]; then
    "$HOME/.local/bin/wal-vesktop"
fi

#
# Apply KDE/Qt pywal16 colors.
#
# kde-pywal also calls kwrite-pywal16, so KWrite/Kate is handled
# automatically here as part of the same wallpaper-change flow.
#
if [ -x "$HOME/.local/bin/kde-pywal" ]; then
    "$HOME/.local/bin/kde-pywal"
fi

#
# ============================================================
# HYPRLOCK
# ============================================================
#

HYPR_COLORS="$HOME/.cache/wal/colors-hyprland.conf"

BACKGROUND=$(sed -n 's/^\$background = //p' "$HYPR_COLORS")
FOREGROUND=$(sed -n 's/^\$foreground = //p' "$HYPR_COLORS")

#
# Full semantic pywal16 bank for Hyprlock.
#
# Dark/subdued:
#   color1  red
#   color2  green
#   color4  blue
#   color5  magenta
#
# Bright:
#   color9   bright red / failure
#   color10  bright green / success
#   color12  primary accent
#   color13  secondary accent
#
COLOR9=$(sed -n 's/^\$color9 = //p' "$HYPR_COLORS")
COLOR10=$(sed -n 's/^\$color10 = //p' "$HYPR_COLORS")
COLOR12=$(sed -n 's/^\$color12 = //p' "$HYPR_COLORS")
COLOR13=$(sed -n 's/^\$color13 = //p' "$HYPR_COLORS")

cat > "$HOME/.config/hypr/hyprlock.conf" <<EOF
background {
    monitor = eDP-1
    path = $WALLPAPER
    color = $BACKGROUND
    blur_passes = 5
}

input-field {
    monitor = eDP-1
    size = 20%, 5%
    outline_thickness = 3

    inner_color = rgba(0, 0, 0, 0.0)

    # Normal state: bright primary + secondary accent.
    outer_color = $COLOR12 $COLOR13 45deg

    # Successful authentication.
    check_color = $COLOR10 $COLOR12 120deg

    # Authentication failure.
    fail_color = $COLOR9 $COLOR13 40deg

    font_color = $FOREGROUND

    fade_on_empty = false
    rounding = 15

    position = 0, -20
    halign = center
    valign = center
}
EOF

#
# ============================================================
# HYPRLAND
# ============================================================
#
# Borders are currently intentionally disabled/transparent.
# Keep them that way rather than introducing a visual change merely
# for the sake of consuming more palette entries.
#

mkdir -p "$HOME/.config/hypr/generated"

cat > "$HOME/.config/hypr/generated/wal-colors.lua" <<EOF
hl.config({
    general = {
        col = {
            active_border = "rgba(0,0,0,0.0)",
            inactive_border = "rgba(0,0,0,0.0)"
        }
    }
})
EOF

#
# Reload Hyprland so it reads the regenerated Lua file.
#
hyprctl reload >/dev/null

#
# Reload SwayNC colors.
#
if pgrep -x swaync >/dev/null 2>&1; then
    swaync-client -rs >/dev/null 2>&1
fi

#
# Update colors in existing Kitty windows.
#
# colors-kitty.conf contains the ANSI 0-15 palette generated by
# pywal16, so Kitty receives the complete palette directly.
#
if pgrep -x kitty >/dev/null 2>&1; then
    kitty @ set-colors --all "$HOME/.cache/wal/colors-kitty.conf" 2>/dev/null
fi

#
# Refresh running Neovim instances.
#
for pid in $(pgrep -x nvim 2>/dev/null); do
    kill -USR1 "$pid"
done

#
# Refresh LibreWolf/Firefox pywalfox colors if available.
#
if command -v pywalfox >/dev/null 2>&1; then
    pywalfox update >/dev/null 2>&1 &
fi
