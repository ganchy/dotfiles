#!/usr/bin/env bash

set -euo pipefail

COLORS="$HOME/.cache/wal/colors.json"
OUT="$HOME/.config/vesktop/settings/quickCss.css"

[[ -f "$COLORS" ]] || exit 0

#
# Pywal special colors.
#
BG="$(jq -r '.special.background' "$COLORS")"
FG="$(jq -r '.special.foreground' "$COLORS")"

#
# Full pywal16 palette.
#
C0="$(jq -r '.colors.color0' "$COLORS")"
C1="$(jq -r '.colors.color1' "$COLORS")"
C2="$(jq -r '.colors.color2' "$COLORS")"
C3="$(jq -r '.colors.color3' "$COLORS")"
C4="$(jq -r '.colors.color4' "$COLORS")"
C5="$(jq -r '.colors.color5' "$COLORS")"
C6="$(jq -r '.colors.color6' "$COLORS")"
C7="$(jq -r '.colors.color7' "$COLORS")"

C8="$(jq -r '.colors.color8' "$COLORS")"
C9="$(jq -r '.colors.color9' "$COLORS")"
C10="$(jq -r '.colors.color10' "$COLORS")"
C11="$(jq -r '.colors.color11' "$COLORS")"
C12="$(jq -r '.colors.color12' "$COLORS")"
C13="$(jq -r '.colors.color13' "$COLORS")"
C14="$(jq -r '.colors.color14' "$COLORS")"
C15="$(jq -r '.colors.color15' "$COLORS")"

cat > "$OUT" <<EOF
/*
 * Generated automatically by wal-vesktop.
 * Do not edit manually.
 *
 * Pywal16 semantic mapping:
 *
 * color0   base dark
 * color1   subdued red
 * color2   subdued green
 * color3   subdued yellow
 * color4   subdued blue/accent
 * color5   subdued magenta
 * color6   subdued cyan
 * color7   subdued foreground
 *
 * color8   muted / secondary
 * color9   danger / error
 * color10  success / positive
 * color11  warning / attention
 * color12  primary accent
 * color13  secondary accent
 * color14  info / links
 * color15  bright foreground
 */

:root {
    /*
     * Raw pywal16 palette.
     */
    --wal-bg: ${BG};
    --wal-fg: ${FG};

    --wal-c0: ${C0};
    --wal-c1: ${C1};
    --wal-c2: ${C2};
    --wal-c3: ${C3};
    --wal-c4: ${C4};
    --wal-c5: ${C5};
    --wal-c6: ${C6};
    --wal-c7: ${C7};

    --wal-c8: ${C8};
    --wal-c9: ${C9};
    --wal-c10: ${C10};
    --wal-c11: ${C11};
    --wal-c12: ${C12};
    --wal-c13: ${C13};
    --wal-c14: ${C14};
    --wal-c15: ${C15};

    /*
     * Semantic colors.
     */
    --wal-accent: ${C12};
    --wal-accent-dark: ${C4};
    --wal-accent-secondary: ${C13};

    --wal-danger: ${C9};
    --wal-success: ${C10};
    --wal-warning: ${C11};
    --wal-info: ${C14};

    --wal-muted: ${C8};
    --wal-bright: ${C15};

    /*
     * Derived pywal surfaces.
     *
     * The main wallpaper background is usually too dark to use
     * everywhere directly, so color8 is mixed into it to create
     * visible Discord UI layers.
     */
    --wal-surface-0: color-mix(
        in srgb,
        ${BG} 82%,
        ${C8} 18%
    );

    --wal-surface-1: color-mix(
        in srgb,
        ${BG} 72%,
        ${C8} 28%
    );

    --wal-surface-2: color-mix(
        in srgb,
        ${BG} 62%,
        ${C8} 38%
    );

    --wal-surface-3: color-mix(
        in srgb,
        ${BG} 55%,
        ${C8} 45%
    );

    /*
     * Hover uses the darker accent.
     * Selected uses the brighter matching color12.
     */
    --wal-hover: color-mix(
        in srgb,
        ${C4} 24%,
        var(--wal-surface-2)
    );

    --wal-selected: color-mix(
        in srgb,
        ${C12} 38%,
        var(--wal-surface-2)
    );
}

.theme-dark,
.theme-light {

    /*
     * Main surfaces.
     */
    --background-primary: var(--wal-surface-0) !important;

    --background-secondary: var(--wal-surface-1) !important;
    --background-secondary-alt: var(--wal-surface-2) !important;

    --background-tertiary: var(--wal-surface-1) !important;

    --background-floating: var(--wal-surface-2) !important;

    /*
     * Modern Discord surface variables.
     */
    --bg-base-primary: var(--wal-surface-0) !important;
    --bg-base-secondary: var(--wal-surface-1) !important;
    --bg-base-tertiary: var(--wal-surface-1) !important;

    --background-base-lowest: var(--wal-surface-0) !important;
    --background-base-lower: var(--wal-surface-0) !important;
    --background-base-low: var(--wal-surface-1) !important;

    --background-surface-low: var(--wal-surface-1) !important;
    --background-surface-high: var(--wal-surface-2) !important;
    --background-surface-higher: var(--wal-surface-2) !important;
    --background-surface-highest: var(--wal-surface-3) !important;

    /*
     * Composer.
     */
    --channeltextarea-background: var(--wal-surface-2) !important;
    --chat-background-default: var(--wal-surface-2) !important;
    --chat-input-container-background: var(--wal-surface-2) !important;
    --input-background: var(--wal-surface-2) !important;

    /*
     * Modals.
     */
    --modal-background: var(--wal-surface-1) !important;
    --modal-footer-background: var(--wal-surface-2) !important;

    /*
     * Main text.
     */
    --text-normal: ${FG} !important;
    --header-primary: ${C15} !important;

    --text-muted: color-mix(
        in srgb,
        ${C8} 72%,
        ${FG}
    ) !important;

    --header-secondary: color-mix(
        in srgb,
        ${FG} 78%,
        ${C8}
    ) !important;

    --channels-default: color-mix(
        in srgb,
        ${FG} 82%,
        ${C8}
    ) !important;

    /*
     * Links / information.
     */
    --text-link: ${C14} !important;
    --text-link-low-saturation: ${C6} !important;

    /*
     * Interactive elements.
     */
    --interactive-normal: color-mix(
        in srgb,
        ${FG} 82%,
        ${C8}
    ) !important;

    --interactive-hover: ${C15} !important;
    --interactive-active: ${C14} !important;

    --interactive-muted: color-mix(
        in srgb,
        ${C8} 70%,
        ${BG}
    ) !important;

    /*
     * Brand/accent.
     *
     * color4 is the subdued counterpart.
     * color12 is the bright active counterpart.
     */
    --brand-experiment: ${C12} !important;
    --brand-500: ${C12} !important;
    --brand-560: ${C4} !important;

    /*
     * Semantic status colors.
     */
    --status-danger: ${C9} !important;
    --status-positive: ${C10} !important;
    --status-warning: ${C11} !important;
}

/*
 * Selected channel / DM.
 */
[class*="modeSelected"] [class*="link"] {
    background: var(--wal-selected) !important;
}

/*
 * Hovered channel / DM.
 */
[class*="channel"]:hover [class*="link"] {
    background: var(--wal-hover) !important;
}

/*
 * Friend / DM rows.
 */
[class*="interactive"]:hover {
    background-color: var(--wal-hover) !important;
}

/*
 * Mentions.
 *
 * Use the bright secondary accent rather than the same blue used
 * for selected channels, so mentions remain visually distinct.
 */
[class*="mentioned"] {
    background-color: color-mix(
        in srgb,
        ${C13} 22%,
        var(--wal-surface-0)
    ) !important;
}

/*
 * Search fields and inputs.
 */
input,
[class*="searchBar"],
[class*="searchBox"] {
    background-color: var(--wal-surface-2) !important;
}

/*
 * Cards such as Active Now.
 */
[class*="itemCard"] {
    background-color: var(--wal-surface-1) !important;
}

[class*="itemCard"]:hover {
    background-color: var(--wal-surface-2) !important;
}

/*
 * Scrollbars.
 */
::-webkit-scrollbar-thumb {
    background-color: color-mix(
        in srgb,
        ${C12} 55%,
        var(--wal-surface-3)
    ) !important;
}

::-webkit-scrollbar-track {
    background-color: var(--wal-surface-0) !important;
}

/*
 * =========================================================
 * CHAT COMPOSER
 * =========================================================
 */

/*
 * Force the visible composer surface.
 */
[class*="channelTextArea"],
[class*="channelTextArea"] [class*="scrollableContainer"],
[class*="channelTextArea"] [class*="themedBackground"] {
    background-color: var(--wal-surface-2) !important;
    background: var(--wal-surface-2) !important;
}

/*
 * Slightly brighter surface while typing.
 */
[class*="channelTextArea"]:focus-within [class*="scrollableContainer"],
[class*="channelTextArea"]:focus-within [class*="themedBackground"] {
    background-color: var(--wal-surface-3) !important;
    background: var(--wal-surface-3) !important;
}

/*
 * Links receive the bright cyan/info slot.
 */
a {
    --text-link: ${C14} !important;
}

EOF

echo "Updated Vesktop pywal16 theme"
echo "  Accent:    ${C12} (color12)"
echo "  Secondary: ${C13} (color13)"
echo "  Info:      ${C14} (color14)"
echo "  Danger:    ${C9}  (color9)"
echo "  Success:   ${C10} (color10)"
echo "  Warning:   ${C11} (color11)"
